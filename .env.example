# Agentic AI Governance & Observability Platform
# Copy this file to .env and fill in your values.

# OpenTelemetry export endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Log file path (default: ./audit_logs.jsonl)
AUDIT_LOG_PATH=./audit_logs.jsonl

# Security scan confidence threshold (default: 0.7)
SECURITY_SCAN_THRESHOLD=0.7

# Commercial license contact (for reporting violations)
COMMERCIAL_LICENSE_CONTACT=via LinkedIn: https://www.linkedin.com/in/dheeraj-krishna-kumar/
